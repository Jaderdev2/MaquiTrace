PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (Neon, Oracle Cloud Free Tier o PostgreSQL local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/maquitrace?schema=public"

# Autenticación JWT con Passport
JWT_SECRET="maquitrace_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Oracle Cloud Infrastructure (OCI) Object Storage (API compatible con S3)
OCI_S3_ENDPOINT="https://<namespace>.compat.objectstorage.<region>.oraclecloud.com"
OCI_S3_REGION="us-ashburn-1"
OCI_S3_ACCESS_KEY_ID="your-customer-secret-key-id"
OCI_S3_SECRET_ACCESS_KEY="your-customer-secret-key"
OCI_BUCKET_NAME="maquitrace-evidencias"
OCI_BUCKET_PUBLIC_URL="https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/maquitrace-evidencias/o"

# Notificaciones por correo electrónico (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notificaciones@maquitrace.com"
SMTP_PASS="your-app-password"
SMTP_FROM="MaquiTrace Notificaciones <notificaciones@maquitrace.com>"
